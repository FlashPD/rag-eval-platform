RAGOPS_ENVIRONMENT=local
RAGOPS_DATABASE_URL=postgresql+asyncpg://ragops:ragops@localhost:5432/ragops
# ECS injects the RDS-managed password separately and uses these component fields.
# When RAGOPS_DATABASE_HOST is set, these values take precedence over DATABASE_URL.
# RAGOPS_DATABASE_HOST=database.example.us-east-1.rds.amazonaws.com
# RAGOPS_DATABASE_PORT=5432
# RAGOPS_DATABASE_NAME=ragops
# RAGOPS_DATABASE_USER=ragops_admin
# RAGOPS_DATABASE_PASSWORD=from-secrets-manager
# In AWS, omit DATABASE_URL and inject the RDS secret as component fields instead:
# RAGOPS_DATABASE_HOST=database.example.us-east-1.rds.amazonaws.com
# RAGOPS_DATABASE_PORT=5432
# RAGOPS_DATABASE_NAME=ragops
# RAGOPS_DATABASE_USER=ragops
# RAGOPS_DATABASE_PASSWORD=secret-from-secrets-manager
# RAGOPS_DATABASE_REQUIRE_SSL=true
RAGOPS_CONFIGURATION_DIRECTORY=config
RAGOPS_ARTIFACT_DIRECTORY=artifacts
# Leave unset for local-only artifacts. ECS sets this to the deployment artifact bucket.
# RAGOPS_ARTIFACT_BUCKET=ragops-artifacts-example
# RAGOPS_ARTIFACT_S3_PREFIX=production
RAGOPS_MODEL_CACHE_DIRECTORY=artifacts/models
# RAGOPS_MODEL_DEVICE=mps
RAGOPS_WORKER_POLL_INTERVAL_SECONDS=1.0
RAGOPS_WORKER_LEASE_SECONDS=300
# Set by Compose; leave unset when running without an OpenTelemetry Collector.
# RAGOPS_OTLP_ENDPOINT=http://localhost:4318
RAGOPS_TELEMETRY_SERVICE_NAME=ragops
# Required for /v1/answer and generation-enabled evaluations.
# RAGOPS_OPENAI_API_KEY=sk-...
RAGOPS_GENERATION_TIMEOUT_SECONDS=30
RAGOPS_ANSWER_CONTEXT_COUNT=10
RAGOPS_ONLINE_EVALUATION_SAMPLE_RATE=0.05
